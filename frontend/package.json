{
  "name": "arqproj-frontend",
  "private": true,
  "description": "The staff app (painel): React + TypeScript, built by Vite and served by backend/ at /painel.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @screenshots",
    "api-types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "api-types:check": "openapi-typescript src/api/openapi.json -o node_modules/.cache/schema-check.d.ts && diff -q src/api/schema.d.ts node_modules/.cache/schema-check.d.ts",
    "screenshots": "playwright test --grep @screenshots"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@tanstack/react-query": "5.104.3",
    "driver.js": "1.8.0",
    "i18next": "26.4.5",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.17",
    "react-image-crop": "11.1.2",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}
