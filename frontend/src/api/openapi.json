{
  "openapi": "3.1.0",
  "info": {
    "title": "Portal",
    "version": "0.1.0"
  },
  "paths": {
    "/api/session": {
      "post": {
        "summary": "Sign In",
        "operationId": "sign_in_api_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Sign Out",
        "operationId": "sign_out_api_session_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/password-link": {
      "post": {
        "summary": "Check Password Link",
        "description": "Before showing the \"choose your password\" form: whose link is it, and does\nit still work?",
        "operationId": "check_password_link_api_password_link_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LinkIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkOut"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/password": {
      "post": {
        "summary": "Choose Password",
        "description": "Use an invite or reset link: set the password, end other sessions, sign in.",
        "operationId": "choose_password_api_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChoosePasswordIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Me",
        "operationId": "me_api_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenant": {
      "get": {
        "summary": "Tenant",
        "operationId": "tenant_api_tenant_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChoosePasswordIn": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "title": "ChoosePasswordIn"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "not_signed_in",
          "csrf_token_missing_or_wrong",
          "invalid_credentials",
          "invalid_request",
          "link_invalid",
          "password_too_short"
        ],
        "title": "ErrorCode"
      },
      "ErrorOut": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorCode"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorOut"
      },
      "LinkIn": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "LinkIn"
      },
      "LinkKind": {
        "type": "string",
        "enum": [
          "invite",
          "reset"
        ],
        "title": "LinkKind"
      },
      "LinkOut": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/LinkKind"
          }
        },
        "type": "object",
        "required": [
          "email",
          "name",
          "kind"
        ],
        "title": "LinkOut"
      },
      "Locale": {
        "type": "string",
        "enum": [
          "pt-BR",
          "en"
        ],
        "title": "Locale",
        "description": "Languages the site's own text is translated into. Text an office writes\nitself is shown as written."
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn"
      },
      "MeOut": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "tenant_slug": {
            "type": "string",
            "title": "Tenant Slug"
          },
          "tenant_name": {
            "type": "string",
            "title": "Tenant Name"
          },
          "tenant_locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "type": "object",
        "required": [
          "email",
          "name",
          "role",
          "tenant_slug",
          "tenant_name",
          "tenant_locale",
          "csrf_token"
        ],
        "title": "MeOut"
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "member"
        ],
        "title": "Role"
      },
      "TenantOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          }
        },
        "type": "object",
        "required": [
          "name",
          "locale"
        ],
        "title": "TenantOut"
      }
    }
  }
}
